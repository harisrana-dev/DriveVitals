# DriveVitals frontend environment configuration.
# Copy to .env (already git-ignored) and adjust as needed.
# All values are optional - sensible defaults are applied in src/api/config.js.

# Base URL for the DriveVitals REST API (FastAPI backend).
VITE_API_BASE=http://localhost:8000/api/v1

# Base URL for the DriveVitals WebSocket endpoints.
VITE_WS_BASE=ws://localhost:8000
