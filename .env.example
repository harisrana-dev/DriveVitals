# DriveVitals - Backend + Docker Compose Environment Configuration.
# Copy to .env and fill in your local values.
# The .env file is git-ignored and must NOT be committed.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
#
# Inside Docker Compose, POSTGRES_HOST and POSTGRES_PORT are overridden by
# compose (host is the `postgres` service name, not localhost). These
# values only apply when running the backend directly on the host.
POSTGRES_USER=drivevitals
POSTGRES_PASSWORD=change_me
POSTGRES_DB=drivevitals_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Authentication session lifetime in hours (default 24).
ACCESS_TOKEN_TTL_HOURS=24

# Comma-separated list of browser origins allowed by the backend CORS
# middleware. The default covers the Dockerized Vite dev server on its
# standard port. Add other origins (e.g. http://127.0.0.1:5173) as needed.
CORS_ORIGINS=http://localhost:5173

# Optional first-administrator bootstrap. Used ONCE when the database has
# no users yet; existing users are never promoted or altered. Configure all
# three values together, or leave all three unset. Never commit real
# credentials.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
