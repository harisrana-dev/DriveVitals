# DriveVitals - Backend Environment Configuration
# Copy to .env and fill in your local values.
# The .env file is git-ignored and must NOT be committed.

POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=drivevitals_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Authentication session lifetime in hours (default 24).
ACCESS_TOKEN_TTL_HOURS=24

# Optional first-administrator bootstrap. Used ONCE when the database has
# no users yet; existing users are never promoted or altered. Configure all
# three values together, or leave all three unset. Never commit real
# credentials.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
