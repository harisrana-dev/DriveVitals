# ============================================================
# DriveVitals - .gitignore
# ============================================================

# ----------------------------
# Environment Variables
# ----------------------------
.env
.env.*
!.env.example

# ----------------------------
# Python
# ----------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual Environments
.venv/
venv/
env/
ENV/

# Python Build
build/
dist/
*.egg-info/
.eggs/

# Python Cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Logs
*.log

# SQLite
*.sqlite3
*.db

# ----------------------------
# Node / React / Vite
# ----------------------------
node_modules/

dist/
build/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite transient config bundle artifact
vite.config.js.timestamp-*

# ----------------------------
# VS Code
# ----------------------------
.vscode/
.mimocode/
.brain_content/

# Uncomment if you want to share workspace settings
# !.vscode/settings.json
# !.vscode/extensions.json

# ----------------------------
# JetBrains
# ----------------------------
.idea/

# ----------------------------
# macOS
# ----------------------------
.DS_Store

# ----------------------------
# Windows
# ----------------------------
Thumbs.db
Desktop.ini

# ----------------------------
# Temporary Files
# ----------------------------
*.tmp
*.temp
*.bak
*.swp

# ----------------------------
# Compiled Files
# ----------------------------
*.so
*.dll
*.dylib
*.exe

# ----------------------------
# Generated Telemetry
# ----------------------------
simulation_output/
generated_data/
logs/

# ----------------------------
# ML
# ----------------------------
checkpoints/
wandb/

# ----------------------------
# Secrets
# ----------------------------
*.pem
*.key
*.crt
*.pfx

# ----------------------------
# Runtime Cache
# ----------------------------
.cache/

# ----------------------------
# Coverage
# ----------------------------
coverage/

# ----------------------------
# Local Database Dumps
# ----------------------------
*.sql
*.dump